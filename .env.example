# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Upstream (DummyJSON)
UPSTREAM_BASE_URL=https://dummyjson.com
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY_MS=100

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=10000

# Cache
CACHE_MAX_ENTRIES=1000
CACHE_TTL_MS=30000

# Auth (use a long random value in production: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_SECONDS=900

# HTTP hardening
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=*
# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
